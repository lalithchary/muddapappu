# ── Site ──────────────────────────────────────────────────────────
# Public URL of the production site (used for canonical tags, sitemap, OG).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin panel ───────────────────────────────────────────────────
# Password protecting /admin and the admin API routes. CHANGE THIS.
ADMIN_PASSWORD=change-me

# ── Data layer ────────────────────────────────────────────────────
# REPO=auto (default): uses Supabase if configured, otherwise local JSON files.
# REPO=json   : force local JSON storage (great for dev / Raspberry Pi hybrid).
# REPO=supabase: force Supabase Postgres (recommended for Vercel production).
REPO=auto

# Supabase (create a free project at supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Affiliate tags ────────────────────────────────────────────────
# Amazon Associates site tag (e.g. mytag-21). Used to build tracking links.
AMAZON_TAG=muddapappu-21

# ── Cuelinks Monetization API (V3) ────────────────────────────────
# Grab your key from https://www.cuelinks.com/api-key with scopes:
#   read:campaigns, read:offers, write:links, read:transactions
CUELINKS_API_KEY=
# Override base URL only if you're testing against staging.
CUELINKS_BASE_URL=https://developers.cuelinks.com/pub_api/v3

# ── Misc ──────────────────────────────────────────────────────────
# Where the local JSON repository lives (relative to project root).
DATA_DIR=data/store
